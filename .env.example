# Copy these into your Vercel project's Environment Variables
# (Project Settings -> Environment Variables) - do NOT commit real
# values to GitHub. This file is just a template.

# Credentials for the /admin page (HTTP Basic Auth on /api/checkin GET)
ADMIN_USER=your-admin-username
ADMIN_PASS=your-admin-password

# Vercel KV connection variables - added automatically when you
# create/connect a KV database from the Vercel dashboard, you do not
# need to set these by hand.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
